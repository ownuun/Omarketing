{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.omarketing.invalid/external/external-job-cancel-request.v1.schema.json",
  "title": "Omarketing external job cancel request v1",
  "description": "Idempotent normalized cancellation request using the original logical key and safe locator.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "external_job_locator",
    "idempotency_key",
    "reason",
    "requested_at"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "omarketing.external-job-cancel-request.v1"
    },
    "request_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "external_job_locator": {
      "$ref": "external-job-locator.v1.schema.json"
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 49,
      "maxLength": 80,
      "pattern": "^oj1\\.[A-Za-z0-9_-]{1,32}\\.[A-Za-z0-9_-]{43}$"
    },
    "reason": {
      "type": "string",
      "enum": [
        "comfy_interrupt",
        "deadline_expired",
        "orphan_reconciliation",
        "execution_error"
      ]
    },
    "requested_at": {
      "type": "string",
      "minLength": 20,
      "maxLength": 27,
      "format": "date-time",
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{1,6})?Z$"
    }
  }
}
