{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.omarketing.invalid/external/external-job-cancel-response.v1.schema.json",
  "title": "Omarketing external job cancel response v1",
  "description": "Correlated normalized result of one bounded idempotent cancel request.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "external_job_locator",
    "status",
    "observed_external_status",
    "observed_at"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "omarketing.external-job-cancel-response.v1"
    },
    "request_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "external_job_locator": {
      "$ref": "external-job-locator.v1.schema.json"
    },
    "status": {
      "type": "string",
      "enum": ["cancel_requested", "canceled", "already_terminal"]
    },
    "observed_external_status": {
      "type": "string",
      "enum": ["accepted", "running", "succeeded", "failed", "canceled"]
    },
    "observed_at": {
      "type": "string",
      "minLength": 20,
      "maxLength": 27,
      "format": "date-time",
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{1,6})?Z$"
    }
  },
  "allOf": [
    {
      "if": {
        "type": "object",
        "properties": {"status": {"const": "cancel_requested"}},
        "required": ["status"]
      },
      "then": {
        "type": "object",
        "properties": {
          "observed_external_status": {"enum": ["accepted", "running"]}
        }
      }
    },
    {
      "if": {
        "type": "object",
        "properties": {"status": {"const": "canceled"}},
        "required": ["status"]
      },
      "then": {
        "type": "object",
        "properties": {
          "observed_external_status": {"const": "canceled"}
        }
      }
    },
    {
      "if": {
        "type": "object",
        "properties": {"status": {"const": "already_terminal"}},
        "required": ["status"]
      },
      "then": {
        "type": "object",
        "properties": {
          "observed_external_status": {
            "enum": ["succeeded", "failed", "canceled"]
          }
        }
      }
    }
  ]
}
