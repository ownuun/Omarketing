{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.omarketing.invalid/external/external-job-acceptance.v1.schema.json",
  "title": "Omarketing external job acceptance v1",
  "description": "Normalized asynchronous acceptance with no provider-supplied status destination.",
  "$comment": "The adapter constructs status requests from its canonical profile and the opaque job id in the safe locator. status_url and all other URL or credential fields are rejected as unknown.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "accepted_at",
    "external_job_locator",
    "status",
    "next_poll_after_seconds"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "omarketing.external-job-acceptance.v1"
    },
    "accepted_at": {
      "type": "string",
      "minLength": 20,
      "maxLength": 27,
      "format": "date-time",
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{1,6})?Z$"
    },
    "external_job_locator": {
      "$ref": "external-job-locator.v1.schema.json"
    },
    "status": {
      "type": "string",
      "const": "accepted"
    },
    "next_poll_after_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 15
    }
  }
}
