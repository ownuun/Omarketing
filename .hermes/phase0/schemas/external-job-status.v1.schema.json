{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.omarketing.invalid/external/external-job-status.v1.schema.json",
  "title": "Omarketing external job status v1",
  "description": "Strict normalized authoritative poll result.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "external_job_locator",
    "observed_at",
    "status",
    "progress",
    "item_outcomes",
    "artifact_handles",
    "warnings",
    "errors",
    "next_poll_after_seconds"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "omarketing.external-job-status.v1"
    },
    "external_job_locator": {
      "$ref": "external-job-locator.v1.schema.json"
    },
    "observed_at": {
      "type": "string",
      "minLength": 20,
      "maxLength": 27,
      "format": "date-time",
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{1,6})?Z$"
    },
    "status": {
      "type": "string",
      "enum": ["accepted", "running", "succeeded", "failed", "canceled"]
    },
    "progress": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/progress"}
      ]
    },
    "item_outcomes": {
      "type": "array",
      "maxItems": 1000,
      "items": {"$ref": "#/$defs/itemOutcome"}
    },
    "artifact_handles": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {"$ref": "external-job-artifact-handle.v1.schema.json"}
    },
    "warnings": {
      "type": "array",
      "maxItems": 32,
      "items": {"$ref": "#/$defs/safeWarning"}
    },
    "errors": {
      "type": "array",
      "maxItems": 32,
      "items": {"$ref": "external-job-error.v1.schema.json"}
    },
    "next_poll_after_seconds": {
      "oneOf": [
        {"type": "null"},
        {"type": "integer", "minimum": 1, "maximum": 15}
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "type": "object",
        "properties": {
          "status": {"enum": ["accepted", "running"]}
        },
        "required": ["status"]
      },
      "then": {
        "type": "object",
        "properties": {
          "next_poll_after_seconds": {
            "type": "integer",
            "minimum": 1,
            "maximum": 15
          }
        }
      }
    },
    {
      "if": {
        "type": "object",
        "properties": {
          "status": {"enum": ["succeeded", "failed", "canceled"]}
        },
        "required": ["status"]
      },
      "then": {
        "type": "object",
        "properties": {
          "next_poll_after_seconds": {"type": "null"}
        }
      }
    },
    {
      "if": {
        "type": "object",
        "properties": {
          "status": {"const": "succeeded"}
        },
        "required": ["status"]
      },
      "then": {
        "type": "object",
        "properties": {
          "errors": {"type": "array", "maxItems": 0},
          "item_outcomes": {
            "type": "array",
            "items": {"$ref": "#/$defs/succeededItemOutcome"}
          }
        }
      }
    },
    {
      "if": {
        "type": "object",
        "properties": {
          "status": {"const": "failed"}
        },
        "required": ["status"]
      },
      "then": {
        "type": "object",
        "properties": {
          "errors": {"type": "array", "minItems": 1}
        }
      }
    }
  ],
  "$defs": {
    "progress": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "max", "unit"],
      "properties": {
        "value": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000000
        },
        "max": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000000
        },
        "unit": {
          "type": "string",
          "enum": ["items", "bytes", "frames", "seconds"]
        }
      }
    },
    "itemOutcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["item_id", "status", "artifact_handle_ids"],
      "properties": {
        "item_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "status": {
          "type": "string",
          "enum": ["pending", "running", "succeeded", "failed"]
        },
        "artifact_handle_ids": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 26,
            "maxLength": 132,
            "pattern": "^ah1_[A-Za-z0-9_-]{22,128}$"
          }
        }
      }
    },
    "succeededItemOutcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["item_id", "status", "artifact_handle_ids"],
      "properties": {
        "item_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "status": {
          "type": "string",
          "const": "succeeded"
        },
        "artifact_handle_ids": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 26,
            "maxLength": 132,
            "pattern": "^ah1_[A-Za-z0-9_-]{22,128}$"
          }
        }
      }
    },
    "safeWarning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code"],
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "cancel_requested_but_external_job_may_continue",
            "PROVIDER_HINT_IGNORED",
            "PROGRESS_RECONCILED",
            "ARTIFACT_QUARANTINED"
          ]
        }
      }
    }
  }
}
