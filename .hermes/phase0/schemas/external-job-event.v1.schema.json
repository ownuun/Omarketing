{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.omarketing.invalid/external/external-job-event.v1.schema.json",
  "title": "Omarketing normalized external job event v1",
  "description": "Optional normalized advisory push event accepted only after provider-profile authentication and replay checks.",
  "$comment": "Signature, timestamp header, nonce, account scope, and key id are authenticated ingress metadata and are deliberately not accepted as event-body extension fields.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "dedupe_key",
    "sequence",
    "external_job_locator",
    "status",
    "progress",
    "emitted_at"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "omarketing.external-job-event.v1"
    },
    "event_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "dedupe_key": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{7,127}$"
    },
    "sequence": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "external_job_locator": {
      "$ref": "external-job-locator.v1.schema.json"
    },
    "status": {
      "type": "string",
      "enum": ["accepted", "running", "succeeded", "failed", "canceled"]
    },
    "progress": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/progress"}
      ]
    },
    "emitted_at": {
      "type": "string",
      "minLength": 20,
      "maxLength": 27,
      "format": "date-time",
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{1,6})?Z$"
    }
  },
  "$defs": {
    "progress": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "max", "unit"],
      "properties": {
        "value": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000000
        },
        "max": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000000
        },
        "unit": {
          "type": "string",
          "enum": ["items", "bytes", "frames", "seconds"]
        }
      }
    }
  }
}
